[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/hud.gd" id="1_hud"]
[ext_resource type="Theme" path="res://ui/theme/hud_theme.tres" id="2_theme"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Crosshair" type="Label" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -10.0
offset_top = -14.0
offset_right = 10.0
offset_bottom = 14.0
mouse_filter = 2
text = "+"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Corners" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme = ExtResource("2_theme")

[node name="Version" type="PanelContainer" parent="Corners"]
layout_mode = 1
offset_left = 12.0
offset_top = 12.0
mouse_filter = 2
theme_type_variation = &"HudPanelLeft"

[node name="Line" type="HBoxContainer" parent="Corners/Version"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Release" type="Label" parent="Corners/Version/Line"]
layout_mode = 2
theme_type_variation = &"HudTitle"

[node name="Commit" type="Label" parent="Corners/Version/Line"]
layout_mode = 2
theme_type_variation = &"HudDetail"

[node name="Players" type="PanelContainer" parent="Corners"]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -12.0
offset_top = 12.0
offset_right = -12.0
grow_horizontal = 0
mouse_filter = 2
theme_type_variation = &"HudPanelRight"

[node name="Lines" type="VBoxContainer" parent="Corners/Players"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Count" type="Label" parent="Corners/Players/Lines"]
layout_mode = 2
theme_type_variation = &"HudTitle"
horizontal_alignment = 2

[node name="Status" type="Label" parent="Corners/Players/Lines"]
layout_mode = 2
theme_type_variation = &"HudDetail"
horizontal_alignment = 2

[node name="Keys" type="PanelContainer" parent="Corners"]
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = -12.0
offset_bottom = -12.0
grow_vertical = 0
mouse_filter = 2
theme_type_variation = &"HudPanelBottomLeft"

[node name="Grid" type="GridContainer" parent="Corners/Keys"]
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 2
columns = 2

[node name="Key0" type="Label" parent="Corners/Keys/Grid"]
layout_mode = 2
theme_type_variation = &"HudKey"
text = "W A S D"

[node name="Action0" type="Label" parent="Corners/Keys/Grid"]
layout_mode = 2
theme_type_variation = &"HudDetail"
text = "move"

[node name="Key1" type="Label" parent="Corners/Keys/Grid"]
layout_mode = 2
theme_type_variation = &"HudKey"
text = "Space / Wheel"

[node name="Action1" type="Label" parent="Corners/Keys/Grid"]
layout_mode = 2
theme_type_variation = &"HudDetail"
text = "jump (on landing to b-hop)"

[node name="Key2" type="Label" parent="Corners/Keys/Grid"]
layout_mode = 2
theme_type_variation = &"HudKey"
text = "Mouse"

[node name="Action2" type="Label" parent="Corners/Keys/Grid"]
layout_mode = 2
theme_type_variation = &"HudDetail"
text = "look"

[node name="Key3" type="Label" parent="Corners/Keys/Grid"]
layout_mode = 2
theme_type_variation = &"HudKey"
text = "Esc"

[node name="Action3" type="Label" parent="Corners/Keys/Grid"]
layout_mode = 2
theme_type_variation = &"HudDetail"
text = "menu"
